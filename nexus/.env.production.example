# =============================================================================
# NEXUS PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your production values
# All keys marked [REQUIRED] must be set for the app to function
# Keys marked [OPTIONAL] have fallbacks or are for optional features

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Node environment - set to 'production' for deployments
NODE_ENV=production

# Server port (defaults to 4567 if not set)
PORT=4567

# Application URL (used for OAuth callbacks and CORS)
# [REQUIRED] for production
VITE_APP_URL=https://your-domain.com

# =============================================================================
# AI SERVICES
# =============================================================================

# Anthropic Claude API Key
# [REQUIRED] for AI features - get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Claude Code Proxy URL (for Max subscription users)
# [OPTIONAL] defaults to localhost:4568 for development
CLAUDE_PROXY_URL=http://localhost:4568

# OpenAI API Key (fallback provider)
# [OPTIONAL] used as fallback when Anthropic fails
OPENAI_API_KEY=sk-...

# =============================================================================
# FRONTEND PROXY CONFIGURATION
# =============================================================================

# Proxy URL for frontend services (Max subscription proxy)
# [OPTIONAL] defaults to localhost:4567 for development
VITE_PROXY_URL=http://localhost:4567

# Embedded API URL for server-side workflow execution
# [OPTIONAL] defaults to localhost:4567 for development
EMBEDDED_API_URL=http://localhost:4567

# =============================================================================
# SUPABASE (Database & Auth)
# =============================================================================

# Supabase Project URL
# [REQUIRED] for data persistence
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (safe for frontend)
# [REQUIRED] for frontend database access
VITE_SUPABASE_ANON_KEY=eyJ...

# Supabase Service Role Key (server-side only, bypasses RLS)
# [REQUIRED] for server-side operations
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# =============================================================================
# COMPOSIO (Integration Platform - 500+ Apps)
# =============================================================================

# Composio API Key
# [REQUIRED] for OAuth integrations (Gmail, Slack, etc.)
COMPOSIO_API_KEY=...

# =============================================================================
# PAYMENTS (Stripe)
# =============================================================================

# Stripe Secret Key
# [REQUIRED] for payments
STRIPE_SECRET_KEY=sk_live_...

# Stripe Publishable Key
# [REQUIRED] for frontend payment elements
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe Webhook Secret
# [REQUIRED] for processing Stripe webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs for subscription tiers
VITE_STRIPE_LAUNCH_PRICE_ID=price_...
VITE_STRIPE_GROWTH_PRICE_ID=price_...
VITE_STRIPE_SCALE_PRICE_ID=price_...

# =============================================================================
# OAUTH PROVIDERS (White-Label - Optional)
# =============================================================================
# These allow direct OAuth without going through Composio proxy
# If not set, OAuth will use Composio's managed credentials

# Google OAuth
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Slack OAuth
SLACK_CLIENT_ID=...
SLACK_CLIENT_SECRET=...

# GitHub OAuth
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...

# =============================================================================
# WHATSAPP INTEGRATIONS
# =============================================================================

# AiSensy Partner ID (for embedded WhatsApp Business signup)
# [OPTIONAL] for WhatsApp Business integration
AISENSY_PARTNER_ID=...
AISENSY_API_KEY=...

# =============================================================================
# VOICE & AVATAR SERVICES
# =============================================================================

# HeyGen API Key (for AI avatars)
# [OPTIONAL] for avatar features
HEYGEN_API_KEY=...

# ElevenLabs API Key (for text-to-speech)
# [OPTIONAL] for voice features
ELEVENLABS_API_KEY=...

# Deepgram API Key (for speech-to-text, Arabic dialect support)
# [OPTIONAL] for voice input
DEEPGRAM_API_KEY=...

# =============================================================================
# CLERK AUTHENTICATION (if using Clerk)
# =============================================================================

# Clerk Publishable Key
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# Clerk Secret Key
CLERK_SECRET_KEY=sk_live_...

# =============================================================================
# DEBUGGING & DEVELOPMENT
# =============================================================================

# Force direct API instead of proxy (useful for debugging)
# Set to 'true' to skip Claude Code Proxy
FORCE_DIRECT_API=false

# Enable verbose logging
DEBUG=false
